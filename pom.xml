<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.bluedock</groupId>
  <artifactId>bluedock-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>BlueDock</name>
  <description>BlueDock collaboration backend</description>

  <modules>
    <module>bluedock-common</module>
    <module>bluedock-auth</module>
    <module>bluedock-user</module>
    <module>bluedock-org</module>
    <module>bluedock-project</module>
    <module>bluedock-task</module>
    <module>bluedock-messenger</module>
    <module>bluedock-file</module>
    <module>bluedock-report</module>
    <module>bluedock-system</module>
    <module>bluedock-search</module>
    <module>bluedock-assistant</module>
    <module>bluedock-realtime</module>
    <module>bluedock-worker-notify</module>
    <module>bluedock-worker-index</module>
    <module>bluedock-boot</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mybatis-plus.version>3.5.14</mybatis-plus.version>
    <qiniu-java-sdk.version>7.19.0</qiniu-java-sdk.version>
    <aliyun-sdk-oss.version>3.18.5</aliyun-sdk-oss.version>
    <tencent-cos-api.version>5.6.273</tencent-cos-api.version>
    <huawei-obs-sdk.version>3.26.6</huawei-obs-sdk.version>
    <poi.version>5.4.1</poi.version>
    <maxmind-geoip2.version>4.2.1</maxmind-geoip2.version>
    <!-- 供 surefire @{argLine} 延迟替换（无 JaCoCo 时为空） -->
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-user</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-org</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-project</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-task</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-messenger</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-file</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-system</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-search</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-assistant</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-realtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-worker-notify</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bluedock</groupId>
        <artifactId>bluedock-worker-index</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qiniu</groupId>
        <artifactId>qiniu-java-sdk</artifactId>
        <version>${qiniu-java-sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun.oss</groupId>
        <artifactId>aliyun-sdk-oss</artifactId>
        <version>${aliyun-sdk-oss.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qcloud</groupId>
        <artifactId>cos_api</artifactId>
        <version>${tencent-cos-api.version}</version>
      </dependency>
      <dependency>
        <groupId>com.huaweicloud</groupId>
        <artifactId>esdk-obs-java</artifactId>
        <version>${huawei-obs-sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <dependency>
        <groupId>com.maxmind.geoip2</groupId>
        <artifactId>geoip2</artifactId>
        <version>${maxmind-geoip2.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- JDK 21+：Mockito inline mock maker 需作为 Java agent 挂载，避免动态 self-attach 失败 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
