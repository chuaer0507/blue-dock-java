# 生产环境变量（复制为 deploy/.env.prod，勿提交 Git）
# 版本：BLUEDOCK_VERSION = git tag（如 v1.0.0）；镜像 tag 同值
# 镜像名写死在 docker-compose.prod.yml（bluedock-boot 等），不在本文件
#   bash deploy/scripts/sync-env-image-tag.sh          # 按当前 git describe 写入
#   bash deploy/scripts/image-build.sh [TAG]          # 构建后自动写入 BLUEDOCK_VERSION
#   bash deploy/scripts/prod-switch.sh <TAG>          # 切换成功后回写 BLUEDOCK_VERSION

BLUEDOCK_VERSION=CHANGE_ME

SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-host:3306/bluedock?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=bluedock
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_DATA_REDIS_HOST=redis-host
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka-host:9092

# JWT（≥32 字符）；生产必须覆盖
BLUEDOCK_JWT_SECRET=CHANGE_ME_MIN_32_CHARS

# 首次启动且库中无 id=1 时，bootstrap 写入下列注释行（邮箱=登录用户名）；已有超管则跳过
#admin账号：
#admin密码：

# 生产禁用系统机器人等开发种子（超管 bootstrap 不依赖本开关）
BLUEDOCK_SEED_ENABLED=false
# 凭据文件路径覆盖（Compose prod 已设 /app/deploy/.env.prod；宿主机 JVM 可指向本文件）
# BLUEDOCK_DEPLOY_ENV_FILE=

# 上传落盘（容器内路径；与 volume 对齐）
BLUEDOCK_UPLOAD_DIR=/app/data/uploads
BLUEDOCK_LICENSE_PATH=/app/data/secrets/license.json

# 搜索：mysql | docs | opensearch
BLUEDOCK_SEARCH_ENGINE=docs
BLUEDOCK_SEARCH_OPENSEARCH_ENABLED=false
# BLUEDOCK_SEARCH_OPENSEARCH_URL=http://opensearch:9200
# BLUEDOCK_SEARCH_OPENSEARCH_INDEX=bluedock-search

# 可选
# BLUEDOCK_GEOIP_MMDB=
# BLUEDOCK_APPS_LIFECYCLE_HOOK_URL=
# BLUEDOCK_APPS_LIFECYCLE_HOOK_FAIL_OPEN=true
# BLUEDOCK_MEETING_ENABLED=true
# BLUEDOCK_MEETING_APP_ID=
# BLUEDOCK_MEETING_APP_CERTIFICATE=
# BLUEDOCK_MEETING_ALLOW_DEV_TOKEN=false
# BLUEDOCK_MEETING_SHARE_BASE_URL=https://app.example.com
# BLUEDOCK_OFFICE_ENABLED=false
# BLUEDOCK_OFFICE_DOCUMENT_SERVER_URL=
# BLUEDOCK_OFFICE_JWT_SECRET=
# BLUEDOCK_OFFICE_PUBLIC_BASE_URL=https://api.example.com
# BLUEDOCK_OFFICE_ALLOW_DEV_TOKEN=false

# Worker 兼容别名（与 SPRING_* 二选一即可；docker profile 优先 SPRING_*）
# BLUEDOCK_DB_URL=
# BLUEDOCK_DB_USER=
# BLUEDOCK_DB_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
# KAFKA_BOOTSTRAP=

# prod-switch 健康检查（:80 探针；业务可走 :443）
# BLUEDOCK_HEALTH_URL=http://localhost/healthz
# BLUEDOCK_READY_URL=http://localhost/readyz
