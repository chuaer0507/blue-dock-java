# 示例：复制后填真实值；勿提交明文生产密钥。
# kubectl -n bluedock-staging create secret generic bluedock-app-secrets \
#   --from-literal=SPRING_DATASOURCE_URL='jdbc:mysql://...' \
#   --from-literal=SPRING_DATASOURCE_USERNAME='bluedock' \
#   --from-literal=SPRING_DATASOURCE_PASSWORD='...' \
#   --from-literal=SPRING_DATA_REDIS_HOST='redis.bluedock-infra.svc' \
#   --from-literal=SPRING_DATA_REDIS_PASSWORD='...' \
#   --from-literal=BLUEDOCK_JWT_SECRET='...'
apiVersion: v1
kind: Secret
metadata:
  name: bluedock-app-secrets
  labels:
    app.kubernetes.io/part-of: bluedock
type: Opaque
stringData:
  SPRING_DATASOURCE_URL: "jdbc:mysql://mysql.bluedock-infra.svc:3306/bluedock?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false"
  SPRING_DATASOURCE_USERNAME: "bluedock"
  SPRING_DATASOURCE_PASSWORD: "CHANGE_ME"
  SPRING_DATA_REDIS_HOST: "redis.bluedock-infra.svc"
  SPRING_DATA_REDIS_PORT: "6379"
  SPRING_DATA_REDIS_PASSWORD: "CHANGE_ME"
  BLUEDOCK_JWT_SECRET: "CHANGE_ME_USE_32_CHARS_MIN________"
