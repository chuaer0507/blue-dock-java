# 本地 / 联调环境变量（复制为 deploy/.env.dev，勿提交含真实密码的文件）
# 版本：BLUEDOCK_VERSION = git tag（如 v1.0.0）；镜像 tag 同值
# 镜像名写死在 docker-compose.yml（bluedock-boot 等），不在本文件
#   bash deploy/scripts/sync-env-image-tag.sh
#   或 make sync-env-tag / image-build 后自动回写 BLUEDOCK_VERSION
#
# 联调镜像栈读本文件：
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env.dev up -d --build
#
# 日常开发：make dev-up + 宿主机 JVM，主要靠 application.yml 默认值。
# 首次启动且库中无 id=1 超管时，bootstrap 会把真实凭据写入下列注释行（邮箱=登录用户名）。

#admin账号：
#admin密码：

BLUEDOCK_VERSION=v1.0.0

# 系统机器人等开发种子（超管 bootstrap 不依赖本开关）
# BLUEDOCK_SEED_ENABLED=true
# 凭据文件路径覆盖（可选；默认 deploy/.env.dev）
# BLUEDOCK_DEPLOY_ENV_FILE=

# 演示帐号（匿名 GET /api/system/demo；空=关闭）
# BLUEDOCK_DEMO_ACCOUNT=demo@bluedock.local
# BLUEDOCK_DEMO_PASSWORD=Demo123!

# JWT（本地默认见 application.yml）
# BLUEDOCK_JWT_SECRET=dev-only-change-in-prod-use-32-chars-min!!

# 连宿主机依赖栈时（若不用 application.yml 默认端口）：
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:13306/bluedock?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
# SPRING_DATASOURCE_USERNAME=bluedock
# SPRING_DATASOURCE_PASSWORD=bluedock_dev
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=16379
# SPRING_DATA_REDIS_PASSWORD=bluedock_redis_dev
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# 搜索（可选 OpenSearch；联调栈加 --profile opensearch）
# BLUEDOCK_SEARCH_ENGINE=opensearch
# BLUEDOCK_SEARCH_OPENSEARCH_ENABLED=true
# BLUEDOCK_SEARCH_OPENSEARCH_URL=http://opensearch:9200
# BLUEDOCK_SEARCH_OPENSEARCH_INDEX=bluedock-search
# 开发依赖栈（宿主机 JVM）用：
# BLUEDOCK_SEARCH_OPENSEARCH_URL=http://127.0.0.1:19200

# OnlyOffice Document Server（可选；联调/开发栈加 --profile onlyoffice）
# BLUEDOCK_OFFICE_ENABLED=true
# BLUEDOCK_OFFICE_JWT_SECRET=bluedock_office_dev_secret
# 开发依赖栈（宿主机 JVM + Nginx :18080）：
# BLUEDOCK_OFFICE_DOCUMENT_SERVER_URL=http://127.0.0.1:18082
# BLUEDOCK_OFFICE_PUBLIC_BASE_URL=http://host.docker.internal:18080
# 联调镜像栈（浏览器访问宿主机 DS；DS 回源 nginx 服务名）：
# BLUEDOCK_OFFICE_DOCUMENT_SERVER_URL=http://localhost:18082
# BLUEDOCK_OFFICE_PUBLIC_BASE_URL=http://nginx
